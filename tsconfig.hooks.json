{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "jsxFactory": "h",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "claude-code": ["./types/claude-code.d.ts"]
    }
  },
  "include": ["plugins/auto-effort-control/hooks", "plugins/auto-effort-control/src", "plugins/auto-effort-control/contract.d.ts", "types"]
}
